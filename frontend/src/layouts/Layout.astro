---
import '../styles/global.css'

interface Props {
  title?: string
}

const { title = 'Registro de Ingresos — Lab Robótica' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-bg text-text antialiased">
    <slot />
  </body>
</html>
